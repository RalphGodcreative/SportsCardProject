# Database Configuration
spring.datasource.url=${DB_URL}
spring.datasource.username=postgres
spring.datasource.password=${DB_PASSWORD}

spring.jpa.hibernate.ddl-auto=validate
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

# Thymeleaf Configuration
spring.thymeleaf.cache=false
spring.thymeleaf.prefix=classpath:/templates/
spring.thymeleaf.suffix=.html
spring.thymeleaf.mode=HTML

# Email Configuration
spring.mail.host=${MAIL_HOST}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

app.mail.from=${MAIL_FROM}
app.mail.from-name=${MAIL_FROM_NAME:RG Sports Cards}

# Static Resources
spring.web.resources.static-locations=classpath:/static/

# YouTube API
youtube.api.key=${YOUTUBE_API_KEY}

# Gemini API
gemini.api.key=${GEMINI_API_KEY}

# eBay Browse API
# Get these from developer.ebay.com → Application Keys
ebay.client.id=${EBAY_CLIENT_ID}
ebay.client.secret=${EBAY_CLIENT_SECRET}
ebay.api.base-url=https://api.ebay.com

# Seed default only, used when the app_settings row is missing (fresh DB). Once the
# migration's INSERT has run, the admin-controlled DB value wins and this is ignored.
app.registration.enabled=false
# Cap on total accounts (0 = unlimited). Same seed-default rule as above (migration V15).
app.registration.max-users=0

# Per-role monthly usage caps live in the app_settings table (seeded by migration
# V11, admin-editable at /admin/settings). Not set here -- UsageLimits has inline
# code defaults for the case where the row is somehow missing.

server.servlet.session.timeout=2d
